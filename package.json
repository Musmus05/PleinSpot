{
  "name": "pleinspot",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node ./backend/server.mjs",
    "dev": "concurrently \"npm run backend\" \"npm run web\"",
    "backend": "node ./backend/server.mjs",
    "build": "npm run build:web",
    "build:web": "expo export --platform web",
    "heroku-postbuild": "npm run build:web",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "expo": "~55.0.6",
    "expo-font": "~55.0.4",
    "fast-xml-parser": "^5.5.6",
    "fflate": "^0.8.2",
    "leaflet": "^1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/react": "~19.2.2",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
